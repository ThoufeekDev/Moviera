```env
# ==========================================
# API Configuration
# ==========================================

# Local backend API
VITE_API_BASE_URL="http://localhost:5000/"


# ==========================================
# Cloudflare Turnstile
# ==========================================

# Public site key used by the frontend
VITE_TURNSTILE_SITE_KEY="your-turnstile-site-key"


# NOTE:
# Do NOT add TURNSTILE_SECRET_KEY here.
# The Turnstile secret key must remain on the backend.
# Configure it in the backend .env file instead.
```
