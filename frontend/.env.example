```env
# ==========================================
# API Configuration
# ==========================================

# Local backend API
VITE_API_BASE_URL="http://localhost:5000/"


# ==========================================
# Cloudflare Turnstile
# ==========================================

# Public site key used by the frontend
VITE_TURNSTILE_SITE_KEY="your-turnstile-site-key"


# ==========================================
# Google Services
# ==========================================

# Google OAuth Client ID for login
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Google Maps Platform (browser-restricted key with Places API enabled)
# Note: Use an API key restricted by HTTP referrers (e.g. localhost, yourdomain.com)
VITE_GOOGLE_MAPS_API_KEY="your-browser-restricted-google-maps-api-key"

# Google Maps Map ID (required for AdvancedMarkerElement)
VITE_GOOGLE_MAPS_MAP_ID=""
```
