generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  THEATRE_ADMIN
  SUPER_ADMIN
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
  WHEELCHAIR
  SOFA
}

enum ShowSeatStatus {
  AVAILABLE
  BOOKED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum Certification {
  U
  UA
  A
  S
}

model User {
  id String @id @default(cuid())

  name     String
  email    String  @unique
  password String?
  phone    String? @unique

  role Role @default(USER)

  googleId String? @unique
  avatar   String?

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  gender      String?
  dateOfBirth DateTime?

  bookings           Booking[]
  movieReviews       MovieReview[]
  theatreReviews     TheatreReview[]
  theatreAssignments TheatreAdminAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model TheatreAdminAssignment {
  id String @id @default(cuid())

  userId    String
  theatreId String

  user    User    @relation(fields: [userId], references: [id])
  theatre Theatre @relation(fields: [theatreId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, theatreId])
  @@index([userId])
  @@index([theatreId])
}

model Person {
  id String @id @default(cuid())

  name          String
  imageUrl      String?
  imagePublicId String?

  castRoles MovieCast[]
  crewRoles MovieCrew[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieCast {
  id        String  @id @default(cuid())
  movieId   String
  personId  String
  character String?

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([movieId, personId, character])
  @@index([movieId])
  @@index([personId])
}

model MovieCrew {
  id       String @id @default(cuid())
  movieId  String
  personId String
  job      String

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([personId])
}

model Language {
  id String @id @default(cuid())

  name String @unique
  code String @unique

  movies MovieLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieLanguage {
  id         String @id @default(cuid())
  movieId    String
  languageId String

  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([movieId, languageId])
  @@index([movieId])
  @@index([languageId])
}

model Genre {
  id String @id @default(cuid())

  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  primaryMovies Movie[]
  movies        MovieGenre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model MovieGenre {
  id String @id @default(cuid())

  movieId String
  genreId String

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([movieId, genreId])
  @@index([movieId])
  @@index([genreId])
}

model MovieCinemaFormat {
  id             String @id @default(cuid())
  movieId        String
  cinemaFormatId String

  movie        Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  cinemaFormat CinemaFormat @relation(fields: [cinemaFormatId], references: [id], onDelete: Cascade)

  @@unique([movieId, cinemaFormatId])
  @@index([movieId])
  @@index([cinemaFormatId])
}

model Movie {
  id String @id @default(cuid())

  title       String
  slug        String   @unique
  description String?
  duration    Int
  releaseDate DateTime

  languages MovieLanguage[]

  primaryGenreId String
  primaryGenre   Genre  @relation(fields: [primaryGenreId], references: [id])

  genres        MovieGenre[]
  certification Certification

  cinemaFormats MovieCinemaFormat[]

  posterUrl      String?
  posterPublicId String?

  backdropUrl      String?
  backdropPublicId String?

  trailerUrl String?

  isActive Boolean @default(true)

  shows Show[]
  cast  MovieCast[]
  crew  MovieCrew[]

  reviews MovieReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryGenreId])
  @@index([isActive])
  @@index([releaseDate])
}

model City {
  id String @id @default(cuid())

  name    String
  state   String
  country String
  slug    String @unique

  isActive Boolean @default(true)

  theatres Theatre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, state, country])
  @@index([isActive])
}

model TheatreFacility {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?
  icon        String?

  isActive Boolean @default(true)

  assignments TheatreFacilityAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model TheatreFacilityAssignment {
  id String @id @default(cuid())

  theatreId  String
  facilityId String

  theatre  Theatre         @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  facility TheatreFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([theatreId, facilityId])
  @@index([theatreId])
  @@index([facilityId])
}

model MovieReview {
  id String @id @default(cuid())

  movieId String
  userId  String

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  title   String?
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, userId])
  @@index([movieId])
  @@index([userId])
}

model TheatreReview {
  id String @id @default(cuid())

  theatreId String
  userId    String

  theatre Theatre @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  title   String?
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([theatreId, userId])
  @@index([theatreId])
  @@index([userId])
}

model TheatreImage {
  id String @id @default(cuid())

  theatreId String
  theatre   Theatre @relation(fields: [theatreId], references: [id], onDelete: Cascade)

  imageUrl      String
  imagePublicId String
  sortOrder     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([theatreId, sortOrder])
}

model Theatre {
  id String @id @default(cuid())

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  name    String
  slug    String
  address String

  description String?

  logoUrl      String?
  logoPublicId String?

  email String?
  phone String?

  latitude  Float?
  longitude Float?

  isActive Boolean @default(true)

  facilities       TheatreFacilityAssignment[]
  images           TheatreImage[]
  screens          Screen[]
  adminAssignments TheatreAdminAssignment[]
  reviews          TheatreReview[]

  licenseNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, name])
  @@unique([cityId, slug])
  @@index([cityId])
  @@index([isActive])
  @@index([latitude, longitude])
}

model CinemaFormat {
  id String @id @default(cuid())

  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  movies  MovieCinemaFormat[]
  screens ScreenCinemaFormat[]
  shows   Show[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ScreenCinemaFormat {
  id String @id @default(cuid())

  screenId       String
  cinemaFormatId String

  screen       Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  cinemaFormat CinemaFormat @relation(fields: [cinemaFormatId], references: [id], onDelete: Cascade)

  @@unique([screenId, cinemaFormatId])
  @@index([screenId])
  @@index([cinemaFormatId])
}

model Screen {
  id String @id @default(cuid())

  theatreId String
  theatre   Theatre @relation(fields: [theatreId], references: [id])

  name String
  slug String

  cinemaFormats ScreenCinemaFormat[]

  isActive Boolean @default(true)

  seats Seat[]
  shows Show[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([theatreId, name])
  @@unique([theatreId, slug])
  @@index([theatreId])
  @@index([isActive])
}

model Seat {
  id String @id @default(cuid())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id])

  rowLabel   String
  seatNumber Int
  label      String

  x        Float
  y        Float
  rotation Float @default(0)

  type SeatType

  isActive Boolean @default(true)

  showSeats ShowSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([screenId, rowLabel, seatNumber])
  @@unique([screenId, label])
  @@index([screenId])
  @@index([isActive])
}

model Show {
  id String @id @default(cuid())

  movieId String
  movie   Movie  @relation(fields: [movieId], references: [id])

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id])

  cinemaFormatId String
  cinemaFormat   CinemaFormat @relation(fields: [cinemaFormatId], references: [id])

  startTime DateTime
  endTime   DateTime

  basePrice Int

  isActive Boolean @default(true)

  showSeats ShowSeat[]
  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([screenId, startTime])
  @@index([cinemaFormatId])
  @@index([startTime, isActive])
}

model ShowSeat {
  id String @id @default(cuid())

  showId String
  show   Show   @relation(fields: [showId], references: [id])

  seatId String
  seat   Seat   @relation(fields: [seatId], references: [id])

  price  Int
  status ShowSeatStatus @default(AVAILABLE)

  bookingSeats BookingSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showId, seatId])
  @@index([showId, status])
}

model Booking {
  id String @id @default(cuid())

  bookingReference String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  showId String
  show   Show   @relation(fields: [showId], references: [id])

  // Historical snapshots.
  movieTitle   String
  theatreName  String
  screenName   String
  showDateTime DateTime

  status BookingStatus @default(PENDING_PAYMENT)

  // All monetary values are stored in paise.
  subtotal       Int
  convenienceFee Int @default(0)
  taxAmount      Int @default(0)
  totalAmount    Int

  // Internal revenue split.
  theatreAmount      Int
  platformCommission Int

  bookingSeats BookingSeat[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([showId])
  @@index([status])
}

model BookingSeat {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  showSeatId String
  showSeat   ShowSeat @relation(fields: [showSeatId], references: [id])

  // Historical snapshots.
  seatLabel String
  price     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, showSeatId])
  @@index([showSeatId])
}

model Payment {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount   Int
  currency String @default("INR")

  status   PaymentStatus   @default(INITIATED)
  provider PaymentProvider @default(STRIPE)

  providerPaymentId String?

  // Prevents duplicate payment operations for the same client request.
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([providerPaymentId])
}
