generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  THEATRE_ADMIN
  SUPER_ADMIN
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
  WHEELCHAIR
  SOFA
}

enum ShowSeatStatus {
  AVAILABLE
  BOOKED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum Certification {
  U
  UA
  A
  S
}

model TheatreAdminAssignment {
  id String @id @default(cuid())

  userId    String
  theatreId String

  user    User    @relation(fields: [userId], references: [id])
  theatre Theatre @relation(fields: [theatreId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, theatreId])
  @@index([userId])
  @@index([theatreId])
}

model User {
  id String @id @default(cuid())

  name     String
  email    String  @unique
  password String?
  phone    String? @unique

  role Role @default(USER)

  googleId String? @unique
  avatar   String?

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  gender      String?
  dateOfBirth DateTime?

  bookings Booking[]

  theatreAssignments TheatreAdminAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Person {
  id            String  @id @default(cuid())
  name          String
  imageUrl      String?
  imagePublicId String?

  castRoles MovieCast[]
  crewRoles MovieCrew[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieCast {
  id        String  @id @default(cuid())
  movieId   String
  personId  String
  character String?

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([movieId, personId, character])
  @@index([movieId])
  @@index([personId])
}

model MovieCrew {
  id       String @id @default(cuid())
  movieId  String
  personId String
  job      String

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([personId])
}

model Language {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  movies MovieLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieLanguage {
  id         String @id @default(cuid())
  movieId    String
  languageId String

  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([movieId, languageId])
  @@index([movieId])
  @@index([languageId])
}

model Genre {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  primaryMovies Movie[]

  movies MovieGenre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieGenre {
  id String @id @default(cuid())

  movieId String
  genreId String

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([movieId, genreId])
  @@index([movieId])
  @@index([genreId])
}

model MovieCinemaFormat {
  id             String @id @default(cuid())
  movieId        String
  cinemaFormatId String

  movie        Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  cinemaFormat CinemaFormat @relation(fields: [cinemaFormatId], references: [id], onDelete: Cascade)

  @@unique([movieId, cinemaFormatId])
  @@index([movieId])
  @@index([cinemaFormatId])
}

model Movie {
  id String @id @default(cuid())

  title       String
  slug        String   @unique
  description String?
  duration    Int
  releaseDate DateTime

  languages MovieLanguage[]

  primaryGenreId String
  primaryGenre   Genre  @relation(fields: [primaryGenreId], references: [id])

  genres        MovieGenre[]
  certification Certification

  cinemaFormats MovieCinemaFormat[]

  posterUrl      String?
  posterPublicId String?

  backdropUrl      String?
  backdropPublicId String?
  trailerUrl       String?

  isActive Boolean @default(true)

  shows Show[]

  cast MovieCast[]

  crew MovieCrew[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryGenreId])
}

model City {
  id String @id @default(cuid())

  name    String
  state   String
  country String
  slug    String @unique

  isActive Boolean @default(true)

  theatres Theatre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, state, country])
}

model Theatre {
  id String @id @default(cuid())

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  name      String
  slug      String
  address   String
  latitude  Float?
  longitude Float?

  isActive Boolean @default(true)

  screens Screen[]

  adminAssignments TheatreAdminAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, name])
  @@unique([cityId, slug])
  @@index([cityId])
  @@index([latitude, longitude])
}

model CinemaFormat {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  movies  MovieCinemaFormat[]
  screens ScreenCinemaFormat[]
  shows   Show[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// it connects screen - cinemaFormat

model ScreenCinemaFormat {
  id String @id @default(cuid())

  screenId       String
  cinemaFormatId String

  screen       Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  cinemaFormat CinemaFormat @relation(fields: [cinemaFormatId], references: [id], onDelete: Cascade)

  @@unique([screenId, cinemaFormatId])
  @@index([screenId])
  @@index([cinemaFormatId])
}

model Screen {
  id String @id @default(cuid())

  theatreId String
  theatre   Theatre @relation(fields: [theatreId], references: [id])

  name String
  slug String

  cinemaFormats ScreenCinemaFormat[]

  isActive Boolean @default(true)

  seats Seat[]
  shows Show[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([theatreId, name])
  @@unique([theatreId, slug])
  @@index([theatreId])
}

model Seat {
  id String @id @default(cuid())

  screenId String // which screen does this seat belong to 
  screen   Screen @relation(fields: [screenId], references: [id])

  rowLabel   String // A 
  seatNumber Int // 1
  label      String // A1

  x        Float
  y        Float
  rotation Float @default(0)

  type SeatType

  isActive Boolean @default(true)

  showSeats ShowSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // This protects the database from accidentally creating
  // duplicate seats in the same screen.
  // @@unique([screenId, label])
  @@unique([screenId, rowLabel, seatNumber])
}

model Show {
  id String @id @default(cuid())

  movieId String // which movie is playing 
  movie   Movie  @relation(fields: [movieId], references: [id])

  screenId String // where is it playing
  screen   Screen @relation(fields: [screenId], references: [id])

  cinemaFormatId String // how is it beign shown 
  cinemaFormat   CinemaFormat @relation(fields: [cinemaFormatId], references: [id])

  startTime DateTime
  endTime   DateTime

  basePrice Int

  isActive Boolean @default(true)

  showSeats ShowSeat[]
  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([screenId])
  @@index([cinemaFormatId])
  @@index([startTime])
}

// Show 1 → Avatar → 6:00 PM
// Show 2 → Avatar → 9:00 PM
// The physical seat A1 is the same seat, but it needs separate
// availability/pricing for each show:

// seat for a particular movie show 
// which seats are available
model ShowSeat {
  id String @id @default(cuid())

  showId String
  show   Show   @relation(fields: [showId], references: [id])

  seatId String
  seat   Seat   @relation(fields: [seatId], references: [id])

  price  Int
  status ShowSeatStatus @default(AVAILABLE)

  bookingSeats BookingSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showId, seatId])
  @@index([showId, status])
}

model Booking {
  id String @id @default(cuid())

  bookingReference String @unique // customer-friendly booking id for ex:MOV-8x92KD

  userId String // who booked it ? thoufeek 
  user   User   @relation(fields: [userId], references: [id])

  showId String // what show did they book ? avatar - 7.30
  show   Show   @relation(fields: [showId], references: [id])

  // Historical snapshots
  movieTitle   String
  theatreName  String
  screenName   String
  showDateTime DateTime

  status BookingStatus @default(PENDING_PAYMENT)

  // All monetary values are stored in paise
  subtotal       Int
  convenienceFee Int @default(0)
  taxAmount      Int @default(0)
  totalAmount    Int

  // Internal revenue split
  theatreAmount      Int
  platformCommission Int

  bookingSeats BookingSeat[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([showId])
  @@index([status])
}

// why do we need booking seat when booking already exists
// on booking can contain mulitple seats 
model BookingSeat {
  id String @id @default(cuid())

  bookingId String // which booking
  booking   Booking @relation(fields: [bookingId], references: [id])

  showSeatId String // which specific show seat
  showSeat   ShowSeat @relation(fields: [showSeatId], references: [id])

  // Historical snapshots
  seatLabel String
  price     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, showSeatId])
  @@index([bookingId])
  @@index([showSeatId])
}

model Payment {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount   Int
  currency String @default("INR")

  status   PaymentStatus   @default(INITIATED)
  provider PaymentProvider @default(STRIPE)

  providerOrderId   String?
  providerPaymentId String?

  // becaus if the customer click pay twise wihtout idempotency protecttion ,backend could potentially create dupicate payment operations
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}
